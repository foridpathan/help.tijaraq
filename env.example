APP_NAME="TijaraQ Help"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
LOG_CHANNEL=stack
LOG_STACK=daily
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_VERSION=3.0.8
# Behind a proxy/CDN set TRUSTED_PROXIES to the proxy IPs (comma separated)
# instead of trusting every proxy. Integration IP allow-listing and rate
# limiting rely on a correct client IP.
TRUST_ALL_PROXIES=false
BILLING_ENABLED=false
NOTIFICATIONS_ENABLED=true
NOTIF_SUBS_ENABLED=true
API_INTEGRATED=true
ENABLE_CONTACT_PAGE=false
PULSE_ENABLED=false
WEBSOCKETS_INTEGRATED=false
INCOMING_EMAIL_INTEGRATED=true

LLM_PROVIDER=openai
ANTHROPIC_TEXT_MODEL=claude-opus-4-0
OPENAI_TEXT_MODEL=gpt-4o-mini
GEMINI_TEXT_MODEL=gemini-2.5-flash
EMBEDDINGS_PROVIDER=openai

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tijaraq_help
DB_USERNAME=root
DB_PASSWORD=null
DB_PREFIX=null
DB_STRICT_MODE=false

STATIC_FILE_DELIVERY=null
UPLOADS_DISK_DRIVER=local
PUBLIC_DISK_DRIVER=local

BROADCAST_CONNECTION=log
REVERB_APP_ID=907406
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_NEW_LINE=null

PUSHER_KEY=null
PUSHER_SECRET=null
PUSHER_APP_ID=null
PUSHER_CLUSTER=mt1

CACHE_STORE=file
QUEUE_CONNECTION=database

SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
SESSION_COOKIE=tijaraq-help-session

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SCOUT_DRIVER=mysql
SCOUT_MYSQL_MODE=extended
SCOUT_QUEUE=false

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=TLS
MAIL_SETUP=false

MAIL_FROM_ADDRESS=example@address.com
MAIL_FROM_NAME="TijaraQ Support"

FACEBOOK_ID=null
FACEBOOK_SECRET=null

GOOGLE_ID=null
GOOGLE_SECRET=null

TWITTER_ID=null
TWITTER_SECRET=null


MAILGUN_DOMAIN=example.domain.com
MAILGUN_SECRET=null

SENTRY_DSN=null

# --- TijaraQ integration (see docs/integrations/tijaraq.md) ---
TIJARAQ_INTEGRATION_ENABLED=false
# JSON map of key id => secret (64+ random chars). Add k2 during rotation, remove k1 afterwards.
TIJARAQ_API_KEYS=
TIJARAQ_WEBHOOK_URL=https://app.tijaraq.com/webhooks/helpdesk
TIJARAQ_WEBHOOK_SECRET=
TIJARAQ_SSO_ISSUER=https://app.tijaraq.com
TIJARAQ_SSO_AUDIENCE=https://help.tijaraq.com
# directory containing <kid>.pem public keys
TIJARAQ_SSO_PUBLIC_KEYS_PATH=storage/app/private/tijaraq-sso/
# comma separated, empty disables the allow-list
TIJARAQ_ALLOWED_IPS=
# requests per minute per tenant
TIJARAQ_RATE_LIMIT_PER_TENANT=120
